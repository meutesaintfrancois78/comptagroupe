# Supabase API Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mode Bac à sable / Page de test cachée (uniquement en dev, false en prod)
VITE_ENABLE_SANDBOX=false

# Bouton « Continuer avec Google » (true une fois Google configuré dans Supabase, voir docs/CONNEXION-GOOGLE.md)
VITE_ENABLE_GOOGLE_AUTH=false
